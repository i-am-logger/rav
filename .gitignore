/target
test_outputs/
# Ignore large logs and artifacts. Keep *.txt scoped to captures - a blanket rule
# would swallow vendored assets such as assets/skins/*/VISCOLOR.TXT.
*.log
*.ansi
test_outputs/*.txt

# devenv / direnv working state (generated, not source)
.devenv/
.devenv.flake.nix
.direnv/
# Generated by the git-hooks module; a symlink into the Nix store
.pre-commit-config.yaml

# macOS Finder metadata
.DS_Store
